{
  "name": "@jokko/core",
  "version": "0.1.0",
  "private": true,
  "description": "Jokko Chain domain core: money, networks, assets, addresses, capabilities, fees, security levels. Pure TypeScript, no I/O.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "libphonenumber-js": "1.13.14"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.2",
    "fast-check": "4.10.2"
  }
}

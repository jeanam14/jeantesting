{
  "name": "@jokko/api",
  "version": "0.1.0",
  "private": true,
  "description": "Jokko Chain backend: public mobile API, private admin API and background workers (one codebase, three processes). Never signs user transactions.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/database/migrate.js",
    "db:seed": "node dist/database/seed.js",
    "start:api": "node dist/main.js",
    "start:admin": "node dist/main-admin.js",
    "start:worker": "node dist/main-worker.js"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@jokko/core": "workspace:*",
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-fastify": "12.1.0",
    "@nestjs/swagger": "12.0.2",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "libphonenumber-js": "1.13.14",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.0",
    "@swc/core": "1.16.2",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.2",
    "drizzle-kit": "0.31.11",
    "unplugin-swc": "2.0.0"
  }
}
